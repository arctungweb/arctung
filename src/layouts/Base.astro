---
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { SITE } from '../config';

interface Props {
  title: string;
  description: string;
  jsonLd?: Record<string, unknown>[];
  noindex?: boolean;
}

const { title, description, jsonLd = [], noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);

// Keep long titles meaningful: preserve a short brand suffix and trim only the
// descriptive part at a word boundary. This avoids endings such as "Why" or
// a bare "|" when a guide headline exceeds the SERP budget.
function truncateTitle(value: string, max = 65): string {
  if (value.length <= max) return value;

  const brandStart = value.search(/\s(?:\||—)\sArcTung/);
  const core = brandStart > 0 ? value.slice(0, brandStart) : value;
  const suffix = brandStart > 0 ? ' | ArcTung' : '';

  // Guide headlines often use "Topic: explanatory subtitle". Prefer the
  // complete topic over clipping halfway through the subtitle.
  const colon = core.indexOf(':');
  if (colon > 24) {
    const topic = core.slice(0, colon).trim();
    if (topic.length + suffix.length <= max) return `${topic}${suffix}`;
    if (topic.length <= max) return topic;
  }

  // A complete unbranded title is better than a clipped title with branding.
  if (core.length <= max) return core;

  const budget = max - suffix.length;
  const cut = core.slice(0, budget + 1);
  const space = cut.lastIndexOf(' ');
  const trimmed = (space > 35 ? cut.slice(0, space) : core.slice(0, budget))
    .trim()
    .replace(/[|:;,\-–—]+$/, '')
    .trim();

  return `${trimmed}${suffix}`;
}
const serpTitle = truncateTitle(title);

// Google truncates meta descriptions around 155-160 chars — cut at a word
// boundary instead of letting the SERP do it mid-sentence.
function truncateDesc(value: string, max = 160): string {
  if (value.length <= max) return value;
  const cut = value.slice(0, max);
  const space = cut.lastIndexOf(' ');
  return (space > 100 ? cut.slice(0, space) : cut).trim();
}
const desc = truncateDesc(description);

const orgLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: SITE.name,
  url: SITE.url,
  logo: `${SITE.url}/og/logo-512.png`,
  email: SITE.email,
  contactPoint: {
    '@type': 'ContactPoint',
    contactType: 'sales',
    email: SITE.email,
    availableLanguage: ['en']
  },
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Heyuan',
    addressRegion: 'Guangdong',
    addressCountry: 'CN'
  }
};
const allLd = [orgLd, ...jsonLd];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{serpTitle}</title>
    <meta name="description" content={desc} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#0d0f12" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={`${SITE.url}/og/og-default.png`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="ArcTung — tungsten-copper electrode wheels, no MOQ, factory-direct" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={`${SITE.url}/og/og-default.png`} />

    <script type="application/ld+json" set:html={JSON.stringify(allLd)} />
    {SITE.crispId && (
      <script is:inline define:vars={{ crispId: SITE.crispId }}>
        window.$crisp = [];
        window.CRISP_WEBSITE_ID = crispId;
        (function () {
          var d = document;
          var s = d.createElement('script');
          s.src = 'https://client.crisp.chat/l.js';
          s.async = 1;
          d.getElementsByTagName('head')[0].appendChild(s);
        })();
      </script>
    )}
  </head>
  <body class="grain flex min-h-screen flex-col">
    <SiteHeader />
    <main class="flex-1">
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>
