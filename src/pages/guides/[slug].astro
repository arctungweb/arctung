---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { SITE } from '../../config';
import { getCollection, type CollectionEntry } from 'astro:content';

export async function getStaticPaths() {
  const guides = await getCollection('guides');
  return guides.map((guide) => ({
    params: { slug: guide.id },
    props: { guide }
  }));
}

const { guide } = Astro.props as { guide: CollectionEntry<'guides'> };
const { Content } = await render(guide);
const url = `${SITE.url}/guides/${guide.id}/`;

const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: guide.data.title,
  description: guide.data.description,
  datePublished: guide.data.pubDate.toISOString(),
  dateModified: guide.data.pubDate.toISOString(),
  author: { '@type': 'Organization', name: SITE.name, url: SITE.url },
  publisher: { '@type': 'Organization', name: SITE.name, url: SITE.url },
  image: [`${SITE.url}/og/og-default.png`],
  mainEntityOfPage: url
};

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url },
    { '@type': 'ListItem', position: 2, name: 'Guides', item: `${SITE.url}/guides/` },
    { '@type': 'ListItem', position: 3, name: guide.data.title, item: url }
  ]
};

const fmt = (d: Date) => d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
---

<Base title={`${guide.data.title} | ArcTung`} description={guide.data.description} jsonLd={[articleLd, breadcrumbLd]}>
  <section class="border-b border-steel-700/60 bg-steel-900">
    <div class="mx-auto max-w-3xl px-4 py-16 sm:px-6 sm:py-20">
      <nav class="rise flex items-center gap-2 font-mono text-[0.72rem] uppercase tracking-widest text-tung-500" aria-label="Breadcrumb">
        <a href="/" class="hover:text-copper-300">Home</a>
        <span>/</span>
        <a href="/guides" class="hover:text-copper-300">Guides</a>
        <span>/</span>
        <span class="text-copper-300">{guide.data.tag}</span>
      </nav>

      <h1 class="rise d2 mt-8 font-display text-3xl font-extrabold leading-tight tracking-tight text-tung-50 sm:text-4xl">
        {guide.data.title}
      </h1>
      <p class="rise d3 mt-4 font-mono text-xs uppercase tracking-widest text-tung-500">
        {guide.data.tag} · {fmt(guide.data.pubDate)}
      </p>
    </div>
  </section>

  <section class="bg-steel-950">
    <div class="mx-auto max-w-3xl px-4 py-12 sm:px-6 sm:py-16">
      <article
        class="guide-body
          [&_a]:text-copper-300 [&_a]:underline [&_a]:underline-offset-4 [&_a:hover]:text-copper-200
          [&_h2]:mt-12 [&_h2]:font-display [&_h2]:text-2xl [&_h2]:font-bold [&_h2]:tracking-tight [&_h2]:text-tung-100
          [&_h3]:mt-8 [&_h3]:font-display [&_h3]:text-lg [&_h3]:font-semibold [&_h3]:text-tung-100
          [&_p]:my-4 [&_p]:leading-relaxed [&_p]:text-tung-300
          [&_ol]:my-4 [&_ol]:list-decimal [&_ol]:space-y-2 [&_ol]:pl-6 [&_li]:text-tung-300
          [&_ul]:my-4 [&_ul]:list-disc [&_ul]:space-y-2 [&_ul]:pl-6
          [&_table]:my-8 [&_table]:w-full [&_table]:border-collapse [&_table]:text-left [&_table]:text-sm
          [&_th]:border [&_th]:border-steel-600 [&_th]:bg-steel-800 [&_th]:px-4 [&_th]:py-2.5 [&_th]:font-mono [&_th]:text-xs [&_th]:uppercase [&_th]:tracking-widest [&_th]:text-copper-300
          [&_td]:border [&_td]:border-steel-600 [&_td]:px-4 [&_td]:py-2.5 [&_td]:text-tung-300"
      >
        <Content />
      </article>

      <div class="mt-14 border-t border-steel-700/60 pt-8">
        <p class="font-display text-lg font-bold text-tung-100">Need this material machined to your drawing?</p>
        <p class="mt-2 text-sm leading-relaxed text-tung-300">
          No MOQ, standard shapes in 10–14 days, quotes valid 7 days.
        </p>
        <a href="/contact" class="mt-5 inline-flex items-center justify-center gap-2 bg-copper-500 px-6 py-3 font-mono text-sm uppercase tracking-widest text-steel-950 transition-colors hover:bg-copper-400">
          Request a quote
        </a>
      </div>
    </div>
  </section>
</Base>