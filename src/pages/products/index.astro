---
import Base from '../../layouts/Base.astro';
import SectionHead from '../../components/SectionHead.astro';
import ProductCard from '../../components/ProductCard.astro';
import { SITE } from '../../config';
import { products } from '../../data/products';

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url },
    { '@type': 'ListItem', position: 2, name: 'Products', item: `${SITE.url}/products/` }
  ]
};

const collectionLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'ArcTung Tungsten-Copper Products',
  description: 'Tungsten-copper electrode wheels, rods, threaded electrodes and custom machined parts.',
  url: `${SITE.url}/products/`,
  mainEntity: {
    '@type': 'ItemList',
    itemListElement: products.map((product, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: product.name,
      url: `${SITE.url}/products/${product.slug}/`
    }))
  }
};
---

<Base
  title="Tungsten-Copper Products | Electrode Wheels & Custom Parts"
  description="Browse W/Cu 75/25 and 70/30 electrode wheels, rods, threaded electrodes and custom machined parts. No MOQ, drawing-based machining and worldwide shipping."
  jsonLd={[breadcrumbLd, collectionLd]}
>
  <section class="border-b border-steel-700/60 bg-steel-900">
    <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 sm:py-20">
      <nav class="rise flex items-center gap-2 font-mono text-[0.72rem] uppercase tracking-widest text-tung-500" aria-label="Breadcrumb">
        <a href="/" class="hover:text-copper-300">Home</a>
        <span>/</span>
        <span class="text-copper-300">Products</span>
      </nav>
      <div class="mt-8">
        <SectionHead
          as="h1"
          kicker="Product line"
          title="Tungsten-copper products machined to your drawing"
          lead="Choose electrode wheels, rods and blocks, threaded electrodes or a custom part. Each product page lists the grade, typical material values, machining limits and ordering details available from the current product data."
        />
      </div>
    </div>
  </section>

  <section class="bg-steel-950">
    <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 sm:py-20">
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {products.map((product) => <ProductCard product={product} />)}
      </div>
      <div class="mt-14 border-t border-steel-700/60 pt-8">
        <p class="max-w-3xl text-sm leading-relaxed text-tung-300">
          Not sure which grade or format fits the drawing? Compare the engineering notes in the
          <a href="/guides/" class="text-copper-300 underline underline-offset-4 hover:text-copper-200">technical guides</a>
          or <a href="/contact/" class="text-copper-300 underline underline-offset-4 hover:text-copper-200">send the drawing for review</a>.
        </p>
      </div>
    </div>
  </section>

  <section class="border-t border-steel-700/60 bg-steel-900">
    <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 sm:py-20">
      <SectionHead
        kicker="Which format"
        title="Same two alloys — the difference is how much machining ships with them"
        lead="Grade selection is one decision. Format is the other, and it is the one that moves price and lead time. Here is what actually changes between the five."
      />

      <div class="hairline overflow-hidden rounded-sm bg-steel-950">
        <div class="overflow-x-auto">
          <table class="compare-table">
            <thead>
              <tr>
                <th>Format</th>
                <th>Grades</th>
                <th>What ships</th>
                <th>Lead time</th>
                <th>Pick it when</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td>Electrode wheels</td>
                <td class="keep-together">75/25 · 70/30</td>
                <td>Finish-machined to your drawing — bore H7, 0.02 mm runout, flat or bevel or R or knurled face</td>
                <td class="keep-together">10–14 days · 20–25 custom</td>
                <td>The part is the seam-welding consumable and mounts on a shaft</td>
              </tr>
              <tr>
                <td>Rods &amp; blocks</td>
                <td class="keep-together">75/25 · 70/30</td>
                <td>Rough-machined or ground stock — round rod, rectangular block, near-net blank</td>
                <td class="keep-together">10–14 days</td>
                <td>You machine your own caps, shanks or EDM electrode sections</td>
              </tr>
              <tr>
                <td>Threaded electrodes</td>
                <td class="keep-together">75/25 · 70/30</td>
                <td>Metric or UNC/UNF thread to drawing, shoulder geometry to suit your gun or holder</td>
                <td class="keep-together">10–14 days · 20–25 custom</td>
                <td>The electrode screws into something rather than being clamped</td>
              </tr>
              <tr>
                <td>Custom parts</td>
                <td class="keep-together">75/25 · 70/30</td>
                <td>Any geometry inside OD 400 × 100 mm, quoted per drawing</td>
                <td class="keep-together">20–25 days (tooling + machining)</td>
                <td>It is not a wheel, a rod or a threaded stud — a fixture, facing or contact assembly</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
      <p class="mt-4 max-w-3xl text-xs leading-relaxed text-tung-500">
        Every format is W/Cu 75/25 or 70/30 — below the 80% tungsten line, so parts ship as ordinary
        industrial goods with no export-licence step. Grades above that line are not in our export range
        and we decline them at quotation rather than after your tooling is committed.
      </p>

      <div class="mt-14 grid gap-8 border-t border-steel-700/60 pt-10 sm:grid-cols-3">
        <div>
          <p class="font-mono text-[0.72rem] uppercase tracking-[0.18em] text-copper-400">1 · Does it screw on?</p>
          <p class="mt-2.5 text-sm leading-relaxed text-tung-300">
            Then the thread callout and shoulder geometry decide whether it seats. Read
            <a href="/guides/threaded-tungsten-copper-electrode-specification/" class="text-copper-300 underline underline-offset-4 hover:text-copper-200">how to specify threaded electrodes</a>.
          </p>
        </div>
        <div>
          <p class="font-mono text-[0.72rem] uppercase tracking-[0.18em] text-copper-400">2 · Do you machine it?</p>
          <p class="mt-2.5 text-sm leading-relaxed text-tung-300">
            Then buy stock and skip the second setup —
            <a href="/guides/how-to-buy-tungsten-copper-rods-blocks/" class="text-copper-300 underline underline-offset-4 hover:text-copper-200">how to buy rods and blocks</a> covers sizes and delivery condition.
          </p>
        </div>
        <div>
          <p class="font-mono text-[0.72rem] uppercase tracking-[0.18em] text-copper-400">3 · Neither?</p>
          <p class="mt-2.5 text-sm leading-relaxed text-tung-300">
            Most buyers are here, and it is the cheaper route on anything with a bore, a profile or a
            tolerance. <a href="/guides/how-to-order-custom-electrode-wheels/" class="text-copper-300 underline underline-offset-4 hover:text-copper-200">Ordering custom wheels</a> walks the drawing through.
          </p>
        </div>
      </div>

      <p class="mt-10 text-sm leading-relaxed text-tung-300">
        Whichever format you land on, the grade decision underneath is the same two options —
        <a href="/guides/w75cu25-vs-w70cu30/" class="text-copper-300 underline underline-offset-4 hover:text-copper-200">W75Cu25 against W70Cu30</a>
        is the comparison that decides it, and it comes down to wear life traded against conductivity.
      </p>
    </div>
  </section>
</Base>
