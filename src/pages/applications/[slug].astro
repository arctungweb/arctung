---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import SectionHead from '../../components/SectionHead.astro';
import ProductCard from '../../components/ProductCard.astro';
import { SITE } from '../../config';
import { applications, type Application } from '../../data/applications';
import { products } from '../../data/products';

export function getStaticPaths() {
  return applications.map((application) => ({
    params: { slug: application.slug },
    props: { application }
  }));
}

const { application } = Astro.props as { application: Application };
const related = application.productSlugs
  .map((slug) => products.find((p) => p.slug === slug))
  .filter((p) => p !== undefined);

const pageLd = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: application.name,
  description: application.tagline,
  url: `${SITE.url}/applications/${application.slug}/`,
  about: { '@type': 'Thing', name: 'Tungsten-copper electrodes' },
  isPartOf: { '@type': 'WebSite', name: SITE.name, url: SITE.url }
};

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url },
    { '@type': 'ListItem', position: 2, name: 'Applications', item: `${SITE.url}/#applications` },
    { '@type': 'ListItem', position: 3, name: application.shortName, item: `${SITE.url}/applications/${application.slug}/` }
  ]
};
---

<Base
  title={`${application.name} | ArcTung W/Cu Electrodes`}
  description={`${application.tagline}. ${application.description[0].slice(0, 140)}`}
  jsonLd={[pageLd, breadcrumbLd]}
>
  <!-- HERO -->
  <section class="relative overflow-hidden border-b border-steel-700/60">
    <div class="absolute inset-0">
      <Image src={application.image} alt={application.imageAlt} width={1600} height={900} class="h-full w-full object-cover" loading="eager" />
      <div class="absolute inset-0 bg-gradient-to-r from-steel-950/95 via-steel-950/80 to-steel-950/45"></div>
      <div class="absolute inset-0 bg-gradient-to-t from-steel-950 via-transparent to-transparent"></div>
    </div>
    <div class="relative mx-auto max-w-7xl px-4 py-20 sm:px-6 sm:py-28">
      <nav class="rise flex items-center gap-2 font-mono text-[0.72rem] uppercase tracking-widest text-tung-500" aria-label="Breadcrumb">
        <a href="/" class="hover:text-copper-300">Home</a>
        <span>/</span>
        <a href="/#applications" class="hover:text-copper-300">Applications</a>
        <span>/</span>
        <span class="text-copper-300">{application.shortName}</span>
      </nav>
      <p class="rise d1 mt-8 font-mono text-xs uppercase tracking-[0.28em] text-copper-400">Application</p>
      <h1 class="rise d2 mt-4 max-w-3xl font-display text-3xl font-extrabold leading-tight tracking-tight text-tung-50 sm:text-5xl">
        {application.name}
      </h1>
      <p class="rise d3 mt-4 max-w-2xl text-lg text-tung-300">{application.tagline}</p>
    </div>
  </section>

  <!-- OVERVIEW + KEY POINTS -->
  <section class="mx-auto max-w-7xl px-4 py-16 sm:px-6 sm:py-20">
    <div class="grid gap-12 lg:grid-cols-5">
      <div class="lg:col-span-2">
        <SectionHead kicker="Overview" title="Why tungsten-copper here" />
        {application.description.map((para) => (
          <p class="mt-4 leading-relaxed text-tung-300">{para}</p>
        ))}
      </div>
      <div class="lg:col-span-3">
        <ul class="grid gap-px overflow-hidden rounded-sm border border-steel-700/60 bg-steel-700/60 sm:grid-cols-2">
          {application.keyPoints.map(([t, d]) => (
            <li class="bg-steel-900 px-6 py-7">
              <p class="font-display text-lg font-bold leading-snug text-tung-50">{t}</p>
              <p class="mt-2 text-sm leading-relaxed text-tung-300">{d}</p>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- RELATED PRODUCTS -->
  <section class="border-t border-steel-700/60 bg-steel-900">
    <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 sm:py-20">
      <SectionHead kicker="Supplied from our floor" title="Products for this application" />
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {related.map((p) => <ProductCard product={p} />)}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="border-t border-steel-700/60">
    <div class="mx-auto flex max-w-7xl flex-col items-start justify-between gap-6 px-4 py-14 sm:px-6 md:flex-row md:items-center">
      <div>
        <h2 class="font-display text-2xl font-bold tracking-tight text-tung-50 sm:text-3xl">
          Running {application.shortName.toLowerCase()} on your line?
        </h2>
        <p class="mt-2 text-tung-300">Send alloy, dimensions and quantity — quote back within 24 hours, held for 7 days.</p>
      </div>
      <a href="/contact" class="inline-flex shrink-0 items-center justify-center gap-2 bg-copper-500 px-7 py-3.5 font-mono text-sm uppercase tracking-widest text-steel-950 transition-colors hover:bg-copper-400">
        Start your RFQ
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
      </a>
    </div>
  </section>
</Base>
