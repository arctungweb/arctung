---
import Base from '../../layouts/Base.astro';
import SectionHead from '../../components/SectionHead.astro';
import { SITE } from '../../config';

const densities: Record<string, number> = {
  '75/25': 15.2, // g/cm³, typical — see /faq
  '70/30': 14.5
};

const faqs: [string, string][] = [
  [
    'How accurate is this weight calculator?',
    'It uses the typical densities for our grades (W/Cu 75/25 ≈ 15.2 g/cm³, W/Cu 70/30 ≈ 14.5 g/cm³) and nominal dimensions. Real parts are machined to your drawing: bore bores out material, edge profiles remove a little more. Expect finished weight within roughly 5% of the calculated value — the quotation sheet gives exact figures.'
  ],
  [
    'Why does weight matter for pricing?',
    'Tungsten is a commodity material, so CuW pricing tracks weight. Volume breaks apply from 20 kg — the calculator flags when your batch crosses that line so you know you are past the first discount tier.'
  ],
  [
    'Can I get a price from this weight?',
    'Quotes are held for 7 days and follow the tungsten market, so we do not publish a fixed $/kg. Send the calculated weight with your drawing via the contact page and you will have a formal quotation — FOB Shenzhen/Nansha — within one business day.'
  ],
  [
    'Can I use this for tungsten carbide or pure tungsten?',
    'Yes for estimating. The material dropdown carries reference densities for pure tungsten (19.25 g/cm³), monolithic tungsten carbide (15.6), a 10% cobalt carbide grade (14.5) and a 90 W heavy alloy (17.0). The geometry and the arithmetic are identical — only the density changes. We machine W/Cu 75/25 and 70/30 only, so a carbide figure is a comparison, not something we can quote.'
  ],
  [
    'How much does tungsten weigh per cubic inch?',
    'Pure tungsten is 0.695 lb/in³; W/Cu 75/25 is 0.549; W/Cu 70/30 is 0.524; monolithic tungsten carbide is 0.564. Multiply by the part volume in cubic inches. Converting from a metric drawing first is usually safer — 1 in³ = 16.387 cm³ — because a small diameter error compounds three times in a volume.'
  ],
  [
    'The drawing gives me a volume, not dimensions. What now?',
    'Multiply directly: kilograms = volume in cm³ × density / 1,000. For pounds, divide the kilogram result by 0.4536. If the volume is in cubic inches, multiply by 16.387 first to get cm³.'
  ]
];

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map(([q, a]) => ({
    '@type': 'Question',
    name: q,
    acceptedAnswer: { '@type': 'Answer', text: a }
  }))
};

const appLd = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'Tungsten Weight Calculator (CuW, Carbide, Pure Tungsten)',
  url: `${SITE.url}/tools/electrode-weight-calculator/`,
  description: 'Estimate the weight of tungsten-copper, pure tungsten, tungsten carbide and molybdenum wheels, rods and blocks from nominal dimensions.',
  applicationCategory: 'UtilityApplication',
  operatingSystem: 'Web',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  publisher: { '@type': 'Organization', name: SITE.name, url: SITE.url }
};
---

<Base
  title="Tungsten Weight Calculator — CuW, Carbide and Pure Tungsten"
  description="Work out the weight of tungsten copper, pure tungsten, tungsten carbide or molybdenum parts — wheels, rods and blocks — from dimensions and density."
  jsonLd={[faqLd, appLd]}
>
  <section class="mx-auto max-w-7xl px-4 py-20 sm:px-6 sm:py-24">
    <SectionHead
      as="h1"
      kicker="Free tool"
      title="Tungsten weight calculator"
      lead="Estimate the weight of W/Cu 75/25 or 70/30 electrode wheels, rods and blocks — or check a reference material like pure tungsten, tungsten carbide or molybdenum — before you request a quote. Nominal dimensions, typical densities, no signup."
    />

    <div class="grid gap-12 lg:grid-cols-5">
      <div class="lg:col-span-3">
        <div class="hairline rounded-sm bg-steel-900 p-6 sm:p-8">
          <div class="grid gap-5 sm:grid-cols-2">
            <label class="block text-sm text-tung-300">
              Shape
              <select id="shape" class="mt-1.5 w-full rounded-sm border border-steel-700 bg-steel-950 px-3 py-2.5 text-tung-50">
                <option value="wheel">Electrode wheel (disc)</option>
                <option value="rod">Rod / cylinder</option>
                <option value="block">Block / plate</option>
              </select>
            </label>
            <label class="block text-sm text-tung-300">
              Material
              <select id="grade" class="mt-1.5 w-full rounded-sm border border-steel-700 bg-steel-950 px-3 py-2.5 text-tung-50">
                <optgroup label="Copper tungsten — our grades">
                  <option value="15.2">W/Cu 75/25 — 15.2 g/cm³</option>
                  <option value="14.5">W/Cu 70/30 — 14.5 g/cm³</option>
                </optgroup>
                <optgroup label="Reference materials — not stocked">
                  <option value="19.25">Pure tungsten — 19.25 g/cm³</option>
                  <option value="15.6">Tungsten carbide (WC) — 15.6 g/cm³</option>
                  <option value="14.5">WC-Co, 10% binder — 14.5 g/cm³</option>
                  <option value="17.0">Tungsten heavy alloy, 90 W — 17.0 g/cm³</option>
                  <option value="10.2">Molybdenum — 10.2 g/cm³</option>
                  <option value="8.96">Copper, ETP — 8.96 g/cm³</option>
                  <option value="2.70">Aluminium 6061 — 2.70 g/cm³</option>
                </optgroup>
              </select>
            </label>
          </div>

          <div id="wheel-fields" class="mt-5 grid gap-5 sm:grid-cols-2">
            <label class="block text-sm text-tung-300">
              Outer diameter (mm)
              <input id="wheel-od" type="number" min="1" max="400" value="100" class="mt-1.5 w-full rounded-sm border border-steel-700 bg-steel-950 px-3 py-2.5 text-tung-50" />
            </label>
            <label class="block text-sm text-tung-300">
              Thickness (mm)
              <input id="wheel-th" type="number" min="1" max="100" value="20" class="mt-1.5 w-full rounded-sm border border-steel-700 bg-steel-950 px-3 py-2.5 text-tung-50" />
            </label>
          </div>

          <div id="rod-fields" class="mt-5 hidden grid gap-5 sm:grid-cols-2">
            <label class="block text-sm text-tung-300">
              Diameter (mm)
              <input id="rod-d" type="number" min="1" value="30" class="mt-1.5 w-full rounded-sm border border-steel-700 bg-steel-950 px-3 py-2.5 text-tung-50" />
            </label>
            <label class="block text-sm text-tung-300">
              Length (mm)
              <input id="rod-l" type="number" min="1" value="100" class="mt-1.5 w-full rounded-sm border border-steel-700 bg-steel-950 px-3 py-2.5 text-tung-50" />
            </label>
          </div>

          <div id="block-fields" class="mt-5 hidden grid gap-5 sm:grid-cols-3">
            <label class="block text-sm text-tung-300">
              Length (mm)
              <input id="blk-l" type="number" min="1" value="100" class="mt-1.5 w-full rounded-sm border border-steel-700 bg-steel-950 px-3 py-2.5 text-tung-50" />
            </label>
            <label class="block text-sm text-tung-300">
              Width (mm)
              <input id="blk-w" type="number" min="1" value="50" class="mt-1.5 w-full rounded-sm border border-steel-700 bg-steel-950 px-3 py-2.5 text-tung-50" />
            </label>
            <label class="block text-sm text-tung-300">
              Height (mm)
              <input id="blk-h" type="number" min="1" value="25" class="mt-1.5 w-full rounded-sm border border-steel-700 bg-steel-950 px-3 py-2.5 text-tung-50" />
            </label>
          </div>

          <div class="mt-7 rounded-sm border border-copper-700/40 bg-steel-950 p-6">
            <p class="font-mono text-[0.72rem] uppercase tracking-widest text-tung-500">Estimated finished weight</p>
            <p class="mt-2 font-display text-4xl font-bold text-copper-300"><span id="result-kg">0.00</span> <span class="text-xl text-tung-300">kg</span></p>
            <p class="mt-1 text-sm text-tung-500"><span id="result-g">0</span> g · volume <span id="result-vol">0</span> cm³</p>
            <p id="break-note" class="mt-3 hidden text-sm text-copper-300">Batch over 20 kg — this crosses our first volume-break tier.</p>
          </div>
        </div>

        <div class="hairline mt-6 rounded-sm bg-steel-900 p-6">
          <p class="font-mono text-[0.72rem] uppercase tracking-widest text-tung-500">How it works</p>
          <ul class="mt-4 space-y-2.5 text-sm leading-relaxed text-tung-300">
            <li>· Nominal dimensions × typical grade density (75/25 ≈ 15.2 g/cm³, 70/30 ≈ 14.5 g/cm³ — see <a class="text-copper-300 hover:text-copper-200" href="/faq/">FAQ specs</a>).</li>
            <li>· The reference materials in the dropdown are there so you can weigh a mating part or a competing material. We machine W/Cu only — a pure tungsten or carbide figure is an estimate, not a quote.</li>
            <li>· Machined features (bore, edge profiles) remove material, so finished parts typically come in about 5% under the calculated figure.</li>
            <li>· For quotation-exact weights, send us the drawing — <a class="text-copper-300 hover:text-copper-200" href="/contact/">formal quote within one business day</a>.</li>
          </ul>
        </div>
      </div>

      <aside class="lg:col-span-2">
        <div class="hairline rounded-sm bg-steel-900 p-6">
          <p class="font-mono text-[0.72rem] uppercase tracking-widest text-tung-500">Next step</p>
          <p class="mt-3 text-sm leading-relaxed text-tung-300">
            Have the weight? Send us the dimensions or drawing and get a formal quotation — FOB Shenzhen/Nansha, no MOQ, samples credited against your first order.
          </p>
          <a href="/contact/" class="mt-5 inline-block rounded-sm bg-copper-500 px-5 py-3 text-sm font-semibold text-steel-950 transition-colors hover:bg-copper-400">Get a quote for this part →</a>
        </div>
        <div class="hairline mt-6 rounded-sm bg-steel-900 p-6">
          <p class="font-mono text-[0.72rem] uppercase tracking-widest text-tung-500">Trade facts</p>
          <ul class="mt-4 space-y-2.5 text-sm text-tung-300">
            <li>No MOQ — single-piece orders welcome</li>
            <li>{SITE.leadStandard} standard · {SITE.leadCustom} custom</li>
            <li>Volume breaks from 20 kg</li>
            <li>{SITE.port} — CIF / DAP on request</li>
            <li>ASTM B702 testing on request</li>
          </ul>
        </div>
        <div class="hairline mt-6 rounded-sm bg-steel-900 p-6">
          <p class="font-mono text-[0.72rem] uppercase tracking-widest text-tung-500">Related</p>
          <ul class="mt-4 space-y-2.5 text-sm">
            <li><a class="text-tung-300 hover:text-copper-300" href="/products/electrode-wheels-75-25/">W/Cu 75/25 electrode wheels</a></li>
            <li><a class="text-tung-300 hover:text-copper-300" href="/products/electrode-wheels-70-30/">W/Cu 70/30 electrode wheels</a></li>
            <li><a class="text-tung-300 hover:text-copper-300" href="/products/rods-blocks/">Rods &amp; blocks</a></li>
            <li><a class="text-tung-300 hover:text-copper-300" href="/guides/tungsten-copper-properties-and-density/">CuW properties &amp; density guide</a></li>
          </ul>
        </div>
      </aside>
    </div>
  </section>

  <section class="border-t border-steel-700/60">
    <div class="mx-auto max-w-7xl px-4 py-20 sm:px-6">
      <SectionHead
        as="h2"
        kicker="Reference table"
        title="Standard sizes, already worked out"
        lead="Nominal weights for the wheel and rod sizes we cut most often, calculated from the same densities the calculator uses. Treat them as a sanity check on a quote or a fast mass estimate on the shop floor."
      />

      <div class="mt-10 grid gap-12 lg:grid-cols-2">
        <div>
          <h3 class="font-display text-lg font-semibold text-tung-50">Electrode wheels (disc)</h3>
          <div class="mt-4 overflow-x-auto">
            <table class="w-full border-collapse text-sm">
              <thead>
                <tr class="border-b border-steel-700 text-left font-mono text-[0.72rem] uppercase tracking-widest text-tung-500">
                  <th class="py-2.5 pr-4 font-normal">OD × thickness</th>
                  <th class="py-2.5 pr-4 font-normal">Volume</th>
                  <th class="py-2.5 pr-4 font-normal">75/25</th>
                  <th class="py-2.5 font-normal">70/30</th>
                </tr>
              </thead>
              <tbody class="text-tung-300">
                <tr class="border-b border-steel-800/60"><td class="py-2.5 pr-4">100 × 20 mm</td><td class="py-2.5 pr-4">157 cm³</td><td class="py-2.5 pr-4">2.4 kg</td><td class="py-2.5">2.3 kg</td></tr>
                <tr class="border-b border-steel-800/60"><td class="py-2.5 pr-4">150 × 25 mm</td><td class="py-2.5 pr-4">442 cm³</td><td class="py-2.5 pr-4">6.7 kg</td><td class="py-2.5">6.4 kg</td></tr>
                <tr class="border-b border-steel-800/60"><td class="py-2.5 pr-4">200 × 30 mm</td><td class="py-2.5 pr-4">942 cm³</td><td class="py-2.5 pr-4">14.3 kg</td><td class="py-2.5">13.7 kg</td></tr>
                <tr class="border-b border-steel-800/60"><td class="py-2.5 pr-4">250 × 40 mm</td><td class="py-2.5 pr-4">1,963 cm³</td><td class="py-2.5 pr-4">29.8 kg</td><td class="py-2.5">28.5 kg</td></tr>
                <tr class="border-b border-steel-800/60"><td class="py-2.5 pr-4">300 × 50 mm</td><td class="py-2.5 pr-4">3,534 cm³</td><td class="py-2.5 pr-4">53.7 kg</td><td class="py-2.5">51.2 kg</td></tr>
                <tr class="border-b border-steel-800/60"><td class="py-2.5 pr-4">350 × 60 mm</td><td class="py-2.5 pr-4">5,774 cm³</td><td class="py-2.5 pr-4">87.7 kg</td><td class="py-2.5">83.7 kg</td></tr>
                <tr><td class="py-2.5 pr-4">400 × 60 mm</td><td class="py-2.5 pr-4">7,540 cm³</td><td class="py-2.5 pr-4">114.6 kg</td><td class="py-2.5">109.3 kg</td></tr>
              </tbody>
            </table>
          </div>
        </div>

        <div>
          <h3 class="font-display text-lg font-semibold text-tung-50">Rods (100 mm length)</h3>
          <div class="mt-4 overflow-x-auto">
            <table class="w-full border-collapse text-sm">
              <thead>
                <tr class="border-b border-steel-700 text-left font-mono text-[0.72rem] uppercase tracking-widest text-tung-500">
                  <th class="py-2.5 pr-4 font-normal">Diameter × length</th>
                  <th class="py-2.5 pr-4 font-normal">Volume</th>
                  <th class="py-2.5 pr-4 font-normal">75/25</th>
                  <th class="py-2.5 font-normal">70/30</th>
                </tr>
              </thead>
              <tbody class="text-tung-300">
                <tr class="border-b border-steel-800/60"><td class="py-2.5 pr-4">Ø20 × 100 mm</td><td class="py-2.5 pr-4">31 cm³</td><td class="py-2.5 pr-4">0.48 kg</td><td class="py-2.5">0.46 kg</td></tr>
                <tr class="border-b border-steel-800/60"><td class="py-2.5 pr-4">Ø30 × 100 mm</td><td class="py-2.5 pr-4">71 cm³</td><td class="py-2.5 pr-4">1.07 kg</td><td class="py-2.5">1.02 kg</td></tr>
                <tr class="border-b border-steel-800/60"><td class="py-2.5 pr-4">Ø40 × 100 mm</td><td class="py-2.5 pr-4">126 cm³</td><td class="py-2.5 pr-4">1.91 kg</td><td class="py-2.5">1.82 kg</td></tr>
                <tr class="border-b border-steel-800/60"><td class="py-2.5 pr-4">Ø50 × 100 mm</td><td class="py-2.5 pr-4">196 cm³</td><td class="py-2.5 pr-4">2.98 kg</td><td class="py-2.5">2.85 kg</td></tr>
                <tr class="border-b border-steel-800/60"><td class="py-2.5 pr-4">Ø63 × 100 mm</td><td class="py-2.5 pr-4">312 cm³</td><td class="py-2.5 pr-4">4.74 kg</td><td class="py-2.5">4.52 kg</td></tr>
                <tr><td class="py-2.5 pr-4">Ø80 × 100 mm</td><td class="py-2.5 pr-4">503 cm³</td><td class="py-2.5 pr-4">7.64 kg</td><td class="py-2.5">7.29 kg</td></tr>
              </tbody>
            </table>
          </div>
          <p class="mt-4 text-sm leading-relaxed text-tung-400">
            For any length, scale linearly: a Ø50 rod weighs 0.0298 kg per mm of length in 75/25.
          </p>
        </div>
      </div>

      <div class="hairline mt-10 rounded-sm bg-steel-900 p-6">
        <p class="font-mono text-[0.72rem] uppercase tracking-widest text-tung-500">The formula behind it</p>
        <p class="mt-3 text-sm leading-relaxed text-tung-300">
          Volume of a disc or rod is <span class="font-mono text-tung-100">π/4 × d² × h</span>; for a block it is <span class="font-mono text-tung-100">l × w × h</span>. Divide by 1,000 to convert mm³ to cm³, multiply by the grade density, then divide by 1,000 again for kilograms. In one line for a wheel:
        </p>
        <p class="mt-3 font-mono text-sm text-copper-300">weight_kg = 0.0007854 × OD² × thickness × density / 1000</p>
        <p class="mt-3 text-sm leading-relaxed text-tung-300">
          With OD and thickness in millimetres and density in g/cm³. That is exactly what this page runs — nothing hidden, no rounding before the final step.
        </p>
      </div>
    </div>
  </section>

  <section class="border-t border-steel-700/60">
    <div class="mx-auto max-w-7xl px-4 py-20 sm:px-6">
      <SectionHead
        as="h2"
        kicker="Density table"
        title="Density by material, in g/cm³ and lb/in³"
        lead="Same numbers the dropdown uses. Handy when a drawing gives you a volume, or when you are pricing an inch-dimension part and only have a pounds-per-cubic-inch figure."
      />

      <div class="mt-10 grid gap-12 lg:grid-cols-2">
        <div class="overflow-x-auto">
          <table class="w-full border-collapse text-sm">
            <thead>
              <tr class="border-b border-steel-700 text-left font-mono text-[0.72rem] uppercase tracking-widest text-tung-500">
                <th class="py-2.5 pr-4 font-normal">Material</th>
                <th class="py-2.5 pr-4 font-normal">g/cm³</th>
                <th class="py-2.5 pr-4 font-normal">lb/in³</th>
                <th class="py-2.5 font-normal">Note</th>
              </tr>
            </thead>
            <tbody class="text-tung-300">
              <tr class="border-b border-steel-800/60"><td class="py-2.5 pr-4">W/Cu 75/25</td><td class="py-2.5 pr-4">15.2</td><td class="py-2.5 pr-4">0.549</td><td class="py-2.5">Stocked</td></tr>
              <tr class="border-b border-steel-800/60"><td class="py-2.5 pr-4">W/Cu 70/30</td><td class="py-2.5 pr-4">14.5</td><td class="py-2.5 pr-4">0.524</td><td class="py-2.5">Stocked</td></tr>
              <tr class="border-b border-steel-800/60"><td class="py-2.5 pr-4">Pure tungsten</td><td class="py-2.5 pr-4">19.25</td><td class="py-2.5 pr-4">0.695</td><td class="py-2.5">Wrought, 99.95%</td></tr>
              <tr class="border-b border-steel-800/60"><td class="py-2.5 pr-4">Tungsten carbide (WC)</td><td class="py-2.5 pr-4">15.6</td><td class="py-2.5 pr-4">0.564</td><td class="py-2.5">Monolithic, no binder</td></tr>
              <tr class="border-b border-steel-800/60"><td class="py-2.5 pr-4">WC-Co, 10% binder</td><td class="py-2.5 pr-4">14.5</td><td class="py-2.5 pr-4">0.524</td><td class="py-2.5">Common tooling grade</td></tr>
              <tr class="border-b border-steel-800/60"><td class="py-2.5 pr-4">Tungsten heavy alloy, 90 W</td><td class="py-2.5 pr-4">17.0</td><td class="py-2.5 pr-4">0.614</td><td class="py-2.5">W-Ni-Fe class</td></tr>
              <tr class="border-b border-steel-800/60"><td class="py-2.5 pr-4">Molybdenum</td><td class="py-2.5 pr-4">10.2</td><td class="py-2.5 pr-4">0.368</td><td class="py-2.5">Pure, sintered or wrought</td></tr>
              <tr class="border-b border-steel-800/60"><td class="py-2.5 pr-4">Copper, ETP</td><td class="py-2.5 pr-4">8.96</td><td class="py-2.5 pr-4">0.324</td><td class="py-2.5">Reference only</td></tr>
              <tr><td class="py-2.5 pr-4">Aluminium 6061</td><td class="py-2.5 pr-4">2.70</td><td class="py-2.5 pr-4">0.098</td><td class="py-2.5">Reference only</td></tr>
            </tbody>
          </table>
          <p class="mt-4 text-sm leading-relaxed text-tung-400">
            Infiltrated CuW density shifts with the tungsten skeleton, so treat these as typical values. A per-batch density report ships with the material on request.
          </p>
        </div>

        <div>
          <h3 class="font-display text-lg font-semibold text-tung-50">Weight per metre of round bar</h3>
          <div class="mt-4 overflow-x-auto">
            <table class="w-full border-collapse text-sm">
              <thead>
                <tr class="border-b border-steel-700 text-left font-mono text-[0.72rem] uppercase tracking-widest text-tung-500">
                  <th class="py-2.5 pr-4 font-normal">Diameter</th>
                  <th class="py-2.5 pr-4 font-normal">75/25</th>
                  <th class="py-2.5 font-normal">70/30</th>
                </tr>
              </thead>
              <tbody class="text-tung-300">
                <tr class="border-b border-steel-800/60"><td class="py-2.5 pr-4">Ø12 mm</td><td class="py-2.5 pr-4">1.72 kg/m</td><td class="py-2.5">1.64 kg/m</td></tr>
                <tr class="border-b border-steel-800/60"><td class="py-2.5 pr-4">Ø16 mm</td><td class="py-2.5 pr-4">3.06 kg/m</td><td class="py-2.5">2.92 kg/m</td></tr>
                <tr class="border-b border-steel-800/60"><td class="py-2.5 pr-4">Ø20 mm</td><td class="py-2.5 pr-4">4.78 kg/m</td><td class="py-2.5">4.56 kg/m</td></tr>
                <tr class="border-b border-steel-800/60"><td class="py-2.5 pr-4">Ø25 mm</td><td class="py-2.5 pr-4">7.46 kg/m</td><td class="py-2.5">7.12 kg/m</td></tr>
                <tr class="border-b border-steel-800/60"><td class="py-2.5 pr-4">Ø30 mm</td><td class="py-2.5 pr-4">10.74 kg/m</td><td class="py-2.5">10.25 kg/m</td></tr>
                <tr class="border-b border-steel-800/60"><td class="py-2.5 pr-4">Ø40 mm</td><td class="py-2.5 pr-4">19.10 kg/m</td><td class="py-2.5">18.22 kg/m</td></tr>
                <tr class="border-b border-steel-800/60"><td class="py-2.5 pr-4">Ø50 mm</td><td class="py-2.5 pr-4">29.85 kg/m</td><td class="py-2.5">28.47 kg/m</td></tr>
                <tr class="border-b border-steel-800/60"><td class="py-2.5 pr-4">Ø63 mm</td><td class="py-2.5 pr-4">47.38 kg/m</td><td class="py-2.5">45.20 kg/m</td></tr>
                <tr><td class="py-2.5 pr-4">Ø80 mm</td><td class="py-2.5 pr-4">76.40 kg/m</td><td class="py-2.5">72.88 kg/m</td></tr>
              </tbody>
            </table>
          </div>
          <p class="mt-4 text-sm leading-relaxed text-tung-400">
            Buying bar stock? Multiply by the length you need. A 300 mm cut of Ø40 in 75/25 is 19.10 × 0.3 ≈ 5.7 kg.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="border-t border-steel-700/60">
    <div class="mx-auto max-w-7xl px-4 py-20 sm:px-6">
      <SectionHead as="h2" kicker="FAQ" title="Calculator questions" lead="" />      <div class="grid gap-8 lg:grid-cols-3">
        {faqs.map(([q, a]) => (
          <div class="hairline rounded-sm bg-steel-900 p-6">
            <h3 class="font-semibold text-tung-50">{q}</h3>
            <p class="mt-3 text-sm leading-relaxed text-tung-300">{a}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <script>
    const $ = (id: string) => document.getElementById(id);
    const shape = $('shape') as HTMLSelectElement;
    const grade = $('grade') as HTMLSelectElement;
    const fields: Record<string, string[]> = {
      wheel: ['wheel-fields'],
      rod: ['rod-fields'],
      block: ['block-fields']
    };
    let g: number, v: number, kg: number;

    function volumeCm3(): number {
      const s = shape.value;
      if (s === 'wheel') {
        const od = parseFloat(($('wheel-od') as HTMLInputElement).value) || 0;
        const th = parseFloat(($('wheel-th') as HTMLInputElement).value) || 0;
        return (Math.PI / 4) * od * od * th / 1000;
      }
      if (s === 'rod') {
        const d = parseFloat(($('rod-d') as HTMLInputElement).value) || 0;
        const l = parseFloat(($('rod-l') as HTMLInputElement).value) || 0;
        return (Math.PI / 4) * d * d * l / 1000;
      }
      const l = parseFloat(($('blk-l') as HTMLInputElement).value) || 0;
      const w = parseFloat(($('blk-w') as HTMLInputElement).value) || 0;
      const h = parseFloat(($('blk-h') as HTMLInputElement).value) || 0;
      return l * w * h / 1000;
    }

    function update() {
      Object.entries(fields).forEach(([k, ids]) =>
        ids.forEach((id) => $(id).classList.toggle('hidden', k !== shape.value)));
      g = parseFloat(grade.value);
      v = volumeCm3();
      kg = (v * g) / 1000;
      $('result-kg').textContent = kg.toFixed(2);
      $('result-g').textContent = Math.round(kg * 1000).toLocaleString('en-US');
      $('result-vol').textContent = v.toFixed(1);
      $('break-note').classList.toggle('hidden', kg < 20);
    }

    [shape, grade].forEach((el) => el.addEventListener('change', update));
    ['wheel-od', 'wheel-th', 'rod-d', 'rod-l', 'blk-l', 'blk-w', 'blk-h'].forEach((id) =>
      $(id).addEventListener('input', update));
    update();
  </script>
</Base>
