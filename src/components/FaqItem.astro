---
interface Props {
  q: string;
  a: string;
}

const { q, a } = Astro.props;
---

<details class="hairline group rounded-sm bg-steel-900">
  <summary class="flex cursor-pointer list-none items-center justify-between gap-4 px-5 py-4 font-display text-base font-semibold text-tung-100 [&::-webkit-details-marker]:hidden">
    {q}
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" class="shrink-0 text-copper-400 transition-transform group-open:rotate-45">
      <path d="M12 5v14M5 12h14"/>
    </svg>
  </summary>
  <div class="border-t border-steel-700/50 px-5 py-4 text-[0.95rem] leading-relaxed text-tung-300">
    {a}
  </div>
</details>
