---
import type { SpecRow } from '../data/products';

interface Props {
  rows: SpecRow[];
  caption?: string;
}

const { rows, caption } = Astro.props;
---

<figure class="hairline overflow-hidden rounded-sm bg-steel-900">
  {caption && (
    <figcaption class="border-b border-steel-700/70 bg-steel-850 px-4 py-2.5 font-mono text-[0.72rem] uppercase tracking-[0.18em] text-tung-500">
      {caption}
    </figcaption>
  )}
  <table class="spec-table">
    <tbody>
      {rows.map((row) => (
        <tr>
          <td>{row.label}</td>
          <td>{row.value}</td>
        </tr>
      ))}
    </tbody>
  </table>
</figure>
