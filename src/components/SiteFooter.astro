---
import { SITE } from '../config';
import { products } from '../data/products';
import { applications } from '../data/applications';

const year = new Date().getFullYear();
---

<footer class="border-t border-steel-700/60 bg-steel-900">
  <div class="mx-auto grid max-w-7xl gap-10 px-4 py-14 sm:px-6 md:grid-cols-5">
    <div>
      <p class="font-display text-xl font-bold text-tung-50">Arc<span class="text-copper-400">Tung</span></p>
      <p class="mt-3 max-w-xs text-sm leading-relaxed text-tung-300">
        Tungsten-copper welding consumables, factory-direct. No MOQ, 10–14 day standard lead time, worldwide shipping.
      </p>
    </div>
    <div>
      <p class="font-mono text-[0.72rem] uppercase tracking-[0.2em] text-tung-500">Products</p>
      <ul class="mt-4 space-y-2.5 text-sm">
        {products.map((p) => (
          <li><a class="text-tung-300 transition-colors hover:text-copper-300" href={`/products/${p.slug}`}>{p.name}</a></li>
        ))}
      </ul>
    </div>
    <div>
      <p class="font-mono text-[0.72rem] uppercase tracking-[0.2em] text-tung-500">Applications</p>
      <ul class="mt-4 space-y-2.5 text-sm">
        {applications.map((a) => (
          <li><a class="text-tung-300 transition-colors hover:text-copper-300" href={`/applications/${a.slug}`}>{a.shortName}</a></li>
        ))}
      </ul>
    </div>
    <div>
      <p class="font-mono text-[0.72rem] uppercase tracking-[0.2em] text-tung-500">Company</p>
      <ul class="mt-4 space-y-2.5 text-sm">
        <li><a class="text-tung-300 transition-colors hover:text-copper-300" href="/factory">Factory &amp; Quality</a></li>
        <li><a class="text-tung-300 transition-colors hover:text-copper-300" href="/faq">FAQ &amp; Specs</a></li>
        <li><a class="text-tung-300 transition-colors hover:text-copper-300" href="/contact">Contact</a></li>
      </ul>
    </div>
    <div>
      <p class="font-mono text-[0.72rem] uppercase tracking-[0.2em] text-tung-500">Trade</p>
      <ul class="mt-4 space-y-2.5 text-sm text-tung-300">
        <li>HS Code 84669390</li>
        <li>{SITE.port}</li>
        <li>Payment: T/T 30% deposit</li>
        <li><a class="transition-colors hover:text-copper-300" href={`mailto:${SITE.email}`}>{SITE.email}</a></li>
      </ul>
    </div>
  </div>
  <div class="border-t border-steel-800">
    <div class="mx-auto flex max-w-7xl flex-col items-start justify-between gap-2 px-4 py-5 font-mono text-[0.72rem] uppercase tracking-widest text-tung-500 sm:flex-row sm:px-6">
      <span>© {year} ArcTung. Made in Heyuan, Guangdong, China.</span>
      <span>W/Cu 75/25 · W/Cu 70/30 · &lt; 80% W</span>
    </div>
  </div>
</footer>
