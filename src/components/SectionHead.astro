---
interface Props {
  kicker: string;
  title: string;
  lead?: string;
  /** Heading level for the title. Use h1 once per page when no other h1 exists. */
  as?: 'h1' | 'h2';
}

const { kicker, title, lead, as: Heading = 'h2' } = Astro.props;
---

<div class="mb-10">
  <p class="flex items-center gap-3 font-mono text-xs uppercase tracking-[0.28em] text-copper-400">
    <span class="inline-block h-px w-8 bg-copper-500"></span>{kicker}
  </p>
  <Heading class="mt-4 max-w-3xl font-display text-3xl font-bold leading-tight tracking-tight text-tung-50 sm:text-4xl">
    {title}
  </Heading>
  {lead && <p class="mt-4 max-w-2xl leading-relaxed text-tung-300" set:html={lead} />}
</div>
